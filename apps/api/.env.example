PORT=3000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
DATABASE_DIR=./.data/pglite
MEDIA_DIR=./.data/media
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-0000000000
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-000000000000000
SIMULATION_TOOLS=true
TIME_SCALE=60

# Google sign-in (optional; button hidden when empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Optional SMTP; when empty, emails are logged and stored in sent_emails
SMTP_URL=
MAIL_FROM="AVERO <no-reply@avero.local>"

# External catalog source (import only; see docs/CATALOG_IMPORT.md)
SKU_API_URL=https://scenesku.com/api/v1/public-packs/shoes
